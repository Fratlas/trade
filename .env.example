# Copiez ce fichier en ".env" SUR LE SERVEUR (jamais dans Git) et remplissez les valeurs.
# Emplacement recommandé : le dossier parent de public_html (ex. /home/uXXXX/.env),
# sinon à la racine du site (public_html/.env, bloqué côté web par .htaccess).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# 64 caractères aléatoires, par exemple générés avec : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Optionnel : assistant IA
OPENROUTER_API_KEY=
